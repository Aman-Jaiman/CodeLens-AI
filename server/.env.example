# Server Configuration
PORT=5000

# FREE AI API Keys (At least one required)
# 1. Google Gemini API (Recommended - Free Tier)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Groq API (Optional Fallback)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=

# 3. OpenRouter API (Optional Fallback)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional deployment configuration
# Comma-separated frontend origins when the client and API use different domains.
# Leave blank for a single-service deployment.
CORS_ORIGIN=

# Provider model overrides. The defaults are suitable for the documented APIs.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free
